<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Filter Properties"
        android:textColor="@color/dark_navy"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Budget Slider / Inputs -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Maximum Budget"
        android:textColor="@color/slate"
        android:textSize="14sp"
        android:layout_marginTop="16dp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderBudget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="5000"
        android:valueTo="25000"
        android:stepSize="1000"
        android:value="20000"
        app:thumbColor="@color/primary"
        app:trackColorActive="@color/primary" />

    <TextView
        android:id="@+id/tvBudgetValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Up to ₹20,000 / month"
        android:textColor="@color/dark_navy"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_gravity="end" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplyFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Apply Filters"
        android:layout_marginTop="24dp" />

</LinearLayout>